# Email Notification Credentials (Optional)
# Logging Settings
LOG_LEVEL=INFO

# Telegram Bot API (Optional - for advanced push notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Set ENABLE_EMAIL_ALERTS=true to receive instant email notifications whenever a trade signal triggers.

ENABLE_EMAIL_ALERTS=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here
RECIPIENT_EMAIL=your_personal_email@gmail.com

# MetaTrader 5 / MetaAPI Execution Settings
# Enable automated execution (requires Windows/Wine OR MetaAPI for Linux)
MT5_DEMO_ENABLED=true

# MetaAPI Cloud REST API (Linux / Multi-Platform fallback)
# Create a free account at https://metaapi.cloud/ to get these credentials
METAAPI_TOKEN=your_metaapi_auth_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here
METAAPI_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai
